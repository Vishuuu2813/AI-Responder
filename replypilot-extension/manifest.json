{
  "manifest_version": 3,
  "name": "ReplyPilot — WhatsApp Auto Reply",
  "version": "1.0.0",
  "description": "Automate WhatsApp Web replies, verify payment screenshots, and auto-send QR codes.",
  "permissions": [
    "storage",
    "clipboardWrite",
    "notifications"
  ],
  "host_permissions": [
    "https://web.whatsapp.com/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "ReplyPilot"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://web.whatsapp.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
